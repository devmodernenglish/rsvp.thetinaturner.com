{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tina-turner-birthday",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
